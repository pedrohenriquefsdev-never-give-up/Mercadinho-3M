rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function staff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().active == true
        && userDoc().storeId == "tempero-da-vovo-marly"
        && (userDoc().role == "admin" || userDoc().role == "manager");
    }

    function admin() {
      return staff() && userDoc().role == "admin";
    }

    match /users/{uid} {
      allow read: if staff();
      allow create, update, delete: if admin();
    }

    match /stores/{storeId} {
      allow read: if resource.data.active == true || staff();
      allow create, update, delete: if staff();
    }

    match /categories/{categoryId} {
      allow read: if resource.data.active == true || staff();
      allow create, update, delete: if staff();
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || staff();
      allow create, update, delete: if staff();
    }

    match /orders/{orderId} {
      allow create: if
        request.resource.data.storeId == "tempero-da-vovo-marly"
        && request.resource.data.customerName is string
        && request.resource.data.customerPhone is string
        && request.resource.data.status == "novo"
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
      allow read, update, delete: if staff();
    }

    match /customers/{customerId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.phone is string;
      allow read, update, delete: if staff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
